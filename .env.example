# ---------------------------------------------------------------
# UltimaPress settings (used by install.sh / docker compose).
# Secrets are generated automatically on first start.
# ---------------------------------------------------------------

# Your domain, without https:// (point its DNS A record at this server first).
# Leave empty to use the server IP with a self-signed certificate.
DOMAIN=

# Database password (the database is never exposed outside the server)
POSTGRES_PASSWORD=change-me

# Email (optional). Without it, emails (password resets, form
# notifications) are written to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=UltimaPress

# ---------------------------------------------------------------
# Local development only (pnpm dev)
# ---------------------------------------------------------------
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ultimapress
# PAYLOAD_SECRET=any-long-random-string
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000
